{
  "name": "axiom",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check": "node scripts/check-deep-dives.mjs",
    "skills:build": "node --import ./scripts/lib/register-ts.mjs scripts/build-skills.mjs",
    "skills:check": "node --import ./scripts/lib/register-ts.mjs scripts/build-skills.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "npm run build && playwright test --config e2e/runner.config.ts",
    "check:attribution": "scripts/check-attribution.sh",
    "prepare": "husky",
    "parity:save": "node scripts/render-parity.mjs save",
    "parity:check": "node scripts/render-parity.mjs check"
  },
  "dependencies": {
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.563.0",
    "next": "16.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
